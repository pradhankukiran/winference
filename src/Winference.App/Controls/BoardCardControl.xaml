<UserControl
    x:Class="Winference.App.Controls.BoardCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Winference.App.Controls"
    Width="320"
    AutomationProperties.Name="{x:Bind Card.AutomationName, Mode=OneWay}">
    <Grid>
    <!-- A starred answer gets an accent outline on top of the normal border. -->
    <Border CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Canvas.ZIndex="1"
            IsHitTestVisible="False" Visibility="{x:Bind Card.IsStarred, Mode=OneWay}" />
    <Border x:Name="Surface" CornerRadius="8" BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid RowSpacing="8" Padding="14,6,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The header is the drag handle. -->
            <Grid x:Name="Handle" Background="Transparent" Margin="-14,-6,-14,0" Padding="14,6,6,0"
                  PointerPressed="Handle_PointerPressed" PointerMoved="Handle_PointerMoved"
                  PointerReleased="Handle_PointerReleased" PointerCaptureLost="Handle_PointerCaptureLost"
                  ToolTipService.ToolTip="Drag to move">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <FontIcon x:Name="KindGlyph" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="KindLabel" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource WinferenceCaptionStyle}" />
                <Button Grid.Column="2" Style="{StaticResource WinferenceSubtleButtonStyle}" Padding="6,4"
                        ToolTipService.ToolTip="More" AutomationProperties.Name="More actions for this card">
                    <FontIcon Glyph="&#xE712;" FontSize="12" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Copy text" Click="Copy_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Delete" Click="Delete_Click" IsEnabled="{x:Bind Card.CanAct, Mode=OneWay}">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Questions are short and plain; answers are formatted and can be long. -->
            <TextBlock x:Name="QuestionText" Grid.Row="1" Text="{x:Bind Card.Text, Mode=OneWay}" TextWrapping="Wrap"
                       FontWeight="SemiBold" IsTextSelectionEnabled="True" />
            <Grid x:Name="AnswerArea" Grid.Row="1" RowSpacing="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer x:Name="AnswerScroll" MaxHeight="280" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled">
                    <controls:MessageContent x:Name="AnswerText" Text="{x:Bind Card.Text, Mode=OneWay}" SizeChanged="AnswerText_SizeChanged" />
                </ScrollViewer>
                <HyperlinkButton x:Name="MoreButton" Grid.Row="1" Padding="0" Click="More_Click" Visibility="Collapsed"
                                 Content="Show more" AutomationProperties.Name="Show the whole answer" />
            </Grid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Card.HasStatus, Mode=OneWay}">
                <ProgressRing Width="14" Height="14" IsActive="{x:Bind Card.IsWriting, Mode=OneWay}"
                              Visibility="{x:Bind Card.IsWriting, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Card.Status, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}"
                           Visibility="{x:Bind Card.ShowPlainStatus, Mode=OneWay}"
                           TextWrapping="Wrap" MaxWidth="280" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{x:Bind Card.Status, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind Card.IsProblem, Mode=OneWay}"
                           TextWrapping="Wrap" MaxWidth="280" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>

            <!-- Answer footer: what produced it, what it cost, and what to do next. -->
            <StackPanel x:Name="Footer" Grid.Row="3" Spacing="6">
                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="-14,0" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource WinferenceSubtleButtonStyle}" Padding="6,4" Click="Star_Click" VerticalAlignment="Top"
                            Visibility="{x:Bind Card.ShowActions, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Card.StarLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind Card.StarLabel, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind Card.StarGlyph, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Card.ModelLine, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}"
                                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Card.StatsLine, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}"
                                   Visibility="{x:Bind Card.HasStats, Mode=OneWay}"
                                   ToolTipService.ToolTip="Writing speed, average chip power while writing, and the share of a full battery it used." />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind Card.ShowActions, Mode=OneWay}">
                    <Button Click="Again_Click" IsEnabled="{x:Bind Card.CanAct, Mode=OneWay}" Style="{StaticResource WinferenceSubtleButtonStyle}"
                            ToolTipService.ToolTip="Answer the same question again with the model that's loaded now">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="12" /><TextBlock Text="Again" /></StackPanel>
                    </Button>
                    <Button x:Name="CompareButton" Click="Compare_Click" IsEnabled="{x:Bind Card.CanAct, Mode=OneWay}"
                            Style="{StaticResource WinferenceSubtleButtonStyle}"
                            ToolTipService.ToolTip="Answer the same question with another model, side by side">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8AB;" FontSize="12" /><TextBlock Text="Compare" /></StackPanel>
                    </Button>
                    <Button Click="FollowUp_Click" IsEnabled="{x:Bind Card.CanAct, Mode=OneWay}" Style="{StaticResource WinferenceSubtleButtonStyle}"
                            ToolTipService.ToolTip="Ask a question that builds on this answer">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE97A;" FontSize="12" /><TextBlock Text="Follow up" /></StackPanel>
                    </Button>
                </StackPanel>
                <Button Click="Stop_Click" Visibility="{x:Bind Card.IsWriting, Mode=OneWay}" Style="{StaticResource WinferenceSubtleButtonStyle}"
                        AutomationProperties.Name="Stop this answer">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE71A;" FontSize="12" /><TextBlock Text="Stop" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</UserControl>
