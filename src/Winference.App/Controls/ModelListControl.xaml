<UserControl
    x:Class="Winference.App.Controls.ModelListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="ModelList">
    <UserControl.Resources>
        <DataTemplate x:Key="FullRowTemplate">
            <Border Style="{StaticResource WinferenceDividedRowStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource WinferenceSectionTitleStyle}"
                                   AutomationProperties.AutomationId="LibraryFamilyName" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource WinferenceCaptionStyle}"
                                   AutomationProperties.AutomationId="ModelStatus" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" Margin="0,0,8,0" Visibility="{Binding InUseVisibility}"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Button Content="{Binding ActionLabel}" Click="Action_Click" MinWidth="72"
                                Visibility="{Binding ActionVisibility}" IsEnabled="{Binding CanAct}"
                                AutomationProperties.Name="{Binding ActionAutomationName}" />
                        <Button Click="More_Click" Style="{StaticResource WinferenceSubtleButtonStyle}" ToolTipService.ToolTip="More"
                                AutomationProperties.Name="{Binding DetailsAutomationName}">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="{Binding ProgressVisibility}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressValue}" Maximum="100"
                                 AutomationProperties.Name="Download progress" />
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactRowTemplate">
            <Grid ColumnSpacing="12" Padding="0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource WinferenceCaptionStyle}" />
                </StackPanel>
                <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="14" Margin="0,0,8,0" Visibility="{Binding InUseVisibility}"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Button Grid.Column="1" Content="{Binding ActionLabel}" Click="Action_Click" VerticalAlignment="Center" MinWidth="64"
                        Visibility="{Binding ActionVisibility}" IsEnabled="{Binding CanAct}"
                        AutomationProperties.Name="{Binding ActionAutomationName}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <SelectorBar x:Name="FilterBar" SelectionChanged="FilterBar_SelectionChanged" Margin="-12,0,0,0"
                     AutomationProperties.AutomationId="ModelFilter" AutomationProperties.Name="Show models that run on">
            <SelectorBarItem x:Name="AllFilter" Text="All" AutomationProperties.AutomationId="FilterAll" />
            <SelectorBarItem x:Name="NpuFilter" Text="NPU" AutomationProperties.AutomationId="FilterNpu" />
            <SelectorBarItem x:Name="GpuNpuFilter" Text="GPU + NPU" AutomationProperties.AutomationId="FilterGpuNpu" />
            <SelectorBarItem x:Name="GpuFilter" Text="GPU" AutomationProperties.AutomationId="FilterGpu" />
        </SelectorBar>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind Library.IsChecking, Mode=OneWay}"
                             AutomationProperties.Name="Checking models" />
                <TextBlock Text="On this PC" Style="{StaticResource WinferenceSectionTitleStyle}" AutomationProperties.HeadingLevel="Level2"
                           AutomationProperties.AutomationId="OnThisPcHeading" Visibility="{x:Bind Library.HasOnThisPc, Mode=OneWay}" />
                <Border x:Name="OnThisPcGroup" Style="{StaticResource WinferenceGroupStyle}" Visibility="{x:Bind Library.HasOnThisPc, Mode=OneWay}">
                    <ItemsControl x:Name="OnThisPcList" ItemsSource="{x:Bind Library.OnThisPc}" IsTabStop="False" Margin="0,-1,0,0"
                                  AutomationProperties.Name="Models on this PC" />
                </Border>
                <StackPanel x:Name="AvailableSection" Spacing="8">
                <TextBlock Text="Available to download" Style="{StaticResource WinferenceSectionTitleStyle}" Margin="0,12,0,0" AutomationProperties.HeadingLevel="Level2"
                           AutomationProperties.AutomationId="AvailableHeading" Visibility="{x:Bind Library.HasAvailable, Mode=OneWay}" />
                <Border x:Name="AvailableGroup" Style="{StaticResource WinferenceGroupStyle}" Visibility="{x:Bind Library.HasAvailable, Mode=OneWay}">
                    <ItemsControl x:Name="AvailableList" ItemsSource="{x:Bind Library.Available}" IsTabStop="False" Margin="0,-1,0,0"
                                  AutomationProperties.Name="Models available to download" />
                </Border>
                </StackPanel>
                <TextBlock Text="{x:Bind Library.EmptyMessage, Mode=OneWay}" Visibility="{x:Bind Library.IsEmpty, Mode=OneWay}"
                           Style="{StaticResource WinferenceSecondaryTextStyle}" Margin="0,12" HorizontalAlignment="Center"
                           AutomationProperties.AutomationId="ModelListEmpty" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
