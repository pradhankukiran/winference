<Window
    x:Class="Winference.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Winference.App.Controls"
    Title="Winference">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootLayout" Background="Transparent" KeyboardAcceleratorPlacementMode="Hidden"
          Loaded="RootLayout_Loaded" ActualThemeChanged="RootLayout_ActualThemeChanged">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="NewChatShortcut_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="SearchShortcut_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="M" Invoked="ModelShortcut_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="StopShortcut_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="Transparent" Padding="20,0,160,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Same shapes as Assets\Winference.svg; keep the two in step. -->
            <Viewbox Width="24" Height="24" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                <Canvas Width="64" Height="64">
                    <Path Fill="#A78BFA" Data="M22.5,3 h3.2 v7 h-3.2 Z M38.3,3 h3.2 v7 h-3.2 Z M22.5,54 h3.2 v7 h-3.2 Z M38.3,54 h3.2 v7 h-3.2 Z M3,22.5 h7 v3.2 h-7 Z M3,38.3 h7 v3.2 h-7 Z M54,22.5 h7 v3.2 h-7 Z M54,38.3 h7 v3.2 h-7 Z" />
                    <Rectangle Canvas.Left="9" Canvas.Top="9" Width="46" Height="46" RadiusX="7" RadiusY="7" Fill="#6D28D9" />
                    <Path Data="M18,21 L24.5,43 L32,29 L39.5,43 L46,21" Stroke="White" StrokeThickness="5.5"
                          StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Miter" StrokeMiterLimit="10" />
                </Canvas>
            </Viewbox>
            <TextBlock Grid.Column="1" Text="Winference" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel x:Name="ShellActivity" Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasActivity, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.ActivityMessage, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ShellActivityText" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar Width="120" VerticalAlignment="Center" Maximum="100"
                             IsIndeterminate="{x:Bind ViewModel.IsActivityIndeterminate, Mode=OneWay}" Value="{x:Bind ViewModel.ActivityValue, Mode=OneWay}"
                             AutomationProperties.AutomationId="ShellActivityProgress" AutomationProperties.Name="Background activity" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,0">
            <InfoBar Margin="0,0,0,8" IsOpen="{x:Bind ViewModel.HasShellError, Mode=OneWay}"
                     IsClosable="True" CloseButtonClick="ShellError_CloseButtonClick"
                     Severity="Error" Title="Something needs attention"
                     Message="{x:Bind ViewModel.ShellError, Mode=OneWay}"
                     AutomationProperties.AutomationId="ShellError"
                     AutomationProperties.Name="Something needs attention"
                     AutomationProperties.HelpText="{x:Bind ViewModel.ShellError, Mode=OneWay}"
                     AutomationProperties.LiveSetting="Polite">
                <InfoBar.ActionButton>
                    <Button Content="Open diagnostics" Click="OpenLogs_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar Margin="0,0,0,8" IsOpen="{x:Bind ViewModel.HasOffer, Mode=OneWay}" IsClosable="True"
                     CloseButtonClick="Offer_CloseButtonClick" Severity="Success"
                     Message="{x:Bind ViewModel.OfferMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="ModelOffer" AutomationProperties.LiveSetting="Polite">
                <InfoBar.ActionButton>
                    <Button Content="Use it now" Click="UseOffered_Click" AutomationProperties.AutomationId="UseOffered" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <Grid Grid.Row="2" x:Name="ShellLayout" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Padding="8,0,8,8" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="NewConversationAction" Style="{StaticResource WinferenceSubtleButtonStyle}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8"
                                Command="{x:Bind ViewModel.Chat.NewChatCommand, Mode=OneWay}" Click="NewChat_Click"
                                IsEnabled="{x:Bind ViewModel.Chat.CanNewChat, Mode=OneWay}"
                                AutomationProperties.AutomationId="NewChat" AutomationProperties.Name="New chat"
                                AutomationProperties.HelpText="Start a new conversation. Earlier chats are kept.">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="New chat" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Click="SearchToggle_Click" Style="{StaticResource WinferenceSubtleButtonStyle}" Padding="10,8"
                                ToolTipService.ToolTip="Search chats (Ctrl+F)" AutomationProperties.AutomationId="SearchChats"
                                AutomationProperties.Name="Search chats">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                        </Button>
                    </Grid>
                    <TextBox x:Name="ConversationSearch" Grid.Row="1" PlaceholderText="Search chats" Visibility="Collapsed"
                             TextChanged="ConversationSearch_TextChanged" KeyDown="ConversationSearch_KeyDown"
                             AutomationProperties.AutomationId="ConversationSearch" AutomationProperties.Name="Search chats" />
                    <ListView x:Name="ConversationList" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Conversation_ItemClick"
                              ContextRequested="Conversations_ContextRequested" KeyDown="ConversationList_KeyDown"
                              ItemContainerStyle="{StaticResource WinferenceSidebarItemStyle}"
                              ItemsSource="{x:Bind ViewModel.Chat.Conversations, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.Chat.SelectedConversation, Mode=TwoWay}"
                              AutomationProperties.AutomationId="ConversationHistory" AutomationProperties.Name="Saved conversations"
                              AutomationProperties.HelpText="Saved conversations on this PC. Choose one to open it.">
                        <ListView.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{Binding Title}"
                                       AutomationProperties.AutomationId="HistoryConversationId" AutomationProperties.HelpText="{Binding Identity}" />
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <ListView x:Name="FooterNavigation" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="True"
                              ItemClick="FooterNavigation_ItemClick" ItemsSource="{x:Bind NavigationItems}"
                              ItemContainerStyle="{StaticResource WinferenceSidebarItemStyle}"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              AutomationProperties.AutomationId="Navigation" AutomationProperties.Name="App sections">
                        <ListView.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" AutomationProperties.AutomationId="{Binding AutomationId}">
                                <FontIcon Glyph="{Binding Glyph}" FontSize="16" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
            </Grid>
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <ContentControl x:Name="PageHost" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>
        <ContentControl x:Name="SetupHost" Grid.Row="2" IsTabStop="False" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" AutomationProperties.AutomationId="SetupHost" />
    </Grid>
</Window>
