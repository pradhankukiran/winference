<Page
    x:Class="Winference.App.Views.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="BoardPage">
    <Page.Resources>
        <Style x:Key="ChipPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- Top bar: board name, live chip activity, and view controls. -->
        <Border Style="{StaticResource WinferencePageHeaderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TitleButton" Click="Title_Click" Style="{StaticResource WinferenceSubtleButtonStyle}" Padding="8,4" Margin="-8,0,0,0"
                        ToolTipService.ToolTip="Rename this board" AutomationProperties.AutomationId="BoardTitle">
                    <TextBlock x:Name="TitleText" Style="{StaticResource WinferencePageTitleStyle}" MaxWidth="420" TextTrimming="CharacterEllipsis"
                               AutomationProperties.HeadingLevel="Level1" />
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            Visibility="{x:Bind Chip.IsVisible, Mode=OneWay}"
                            ToolTipService.ToolTip="How hard your NPU and GPU are working right now, the power they use and how fast the answer is written."
                            AutomationProperties.AutomationId="ChipActivity" AutomationProperties.Name="{x:Bind Chip.Summary, Mode=OneWay}">
                    <Border Style="{StaticResource ChipPillStyle}" Visibility="{x:Bind Chip.IsMeasuring, Mode=OneWay}">
                        <TextBlock Text="Measuring…" Style="{StaticResource WinferenceCaptionStyle}" />
                    </Border>
                    <Border Style="{StaticResource ChipPillStyle}" Visibility="{x:Bind Chip.ShowNpu, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Chip.NpuText, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}" />
                    </Border>
                    <Border Style="{StaticResource ChipPillStyle}" Visibility="{x:Bind Chip.ShowGpu, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Chip.GpuText, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}" />
                    </Border>
                    <Border Style="{StaticResource ChipPillStyle}" Visibility="{x:Bind Chip.ShowChip, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Chip.ChipText, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Click="ZoomOut_Click" Style="{StaticResource WinferenceSubtleButtonStyle}" ToolTipService.ToolTip="Zoom out"
                            AutomationProperties.Name="Zoom out"><FontIcon Glyph="&#xE71F;" FontSize="14" /></Button>
                    <Button Click="ZoomIn_Click" Style="{StaticResource WinferenceSubtleButtonStyle}" ToolTipService.ToolTip="Zoom in"
                            AutomationProperties.Name="Zoom in"><FontIcon Glyph="&#xE8A3;" FontSize="14" /></Button>
                    <Button Click="Fit_Click" Style="{StaticResource WinferenceSubtleButtonStyle}" ToolTipService.ToolTip="Fit the whole board"
                            AutomationProperties.Name="Fit the whole board"><FontIcon Glyph="&#xE9A6;" FontSize="14" /></Button>
                    <Button Click="Tidy_Click" Style="{StaticResource WinferenceSubtleButtonStyle}" ToolTipService.ToolTip="Tidy: line the cards up again"
                            AutomationProperties.Name="Tidy the board"><FontIcon Glyph="&#xF0E2;" FontSize="14" /></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="Viewport" ZoomMode="Enabled" MinZoomFactor="0.25" MaxZoomFactor="2"
                          HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                          SizeChanged="Viewport_SizeChanged" AutomationProperties.Name="Board">
                <Canvas x:Name="Surface" Background="Transparent" Margin="48" ActualThemeChanged="Surface_ActualThemeChanged">
                    <Canvas x:Name="Lines" IsHitTestVisible="False" />
                </Canvas>
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" Spacing="8" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <TextBlock Text="Ask anything to start this board" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Style="{StaticResource WinferenceCaptionStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="Each answer becomes a card. Compare it with another model, star the better one, and follow up from any card. Everything stays on this PC." />
            </StackPanel>
            <Border x:Name="LineBrushSource" Visibility="Collapsed" Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            <InfoBar x:Name="SaveProblem" VerticalAlignment="Top" Margin="16,8" IsClosable="False" Severity="Error" />
        </Grid>

        <!-- The question box. A follow-up shows which answer it continues. -->
        <Border Grid.Row="2" Style="{StaticResource WinferenceCardStyle}" Padding="6" CornerRadius="12" Margin="24,0,24,16"
                MaxWidth="{StaticResource WinferenceContentWidth}" AutomationProperties.AutomationId="AskSurface">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="FollowUpBar" ColumnSpacing="8" Padding="8,2,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE97A;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="FollowUpText" Grid.Column="1" Style="{StaticResource WinferenceCaptionStyle}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Click="ClearFollowUp_Click" Style="{StaticResource WinferenceSubtleButtonStyle}" Padding="6,2"
                            ToolTipService.ToolTip="Start a new thread instead" AutomationProperties.Name="Start a new thread instead">
                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="AskBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" BorderThickness="0" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewKeyDown="AskBox_PreviewKeyDown" KeyUp="AskBox_KeyUp" TextChanged="AskBox_TextChanged"
                             TextCompositionStarted="AskBox_TextCompositionStarted" TextCompositionEnded="AskBox_TextCompositionEnded"
                             AutomationProperties.AutomationId="AskBox" AutomationProperties.Name="Question"
                             AutomationProperties.HelpText="Enter asks. Shift+Enter adds a new line." />
                    <DropDownButton x:Name="ReadWindowButton" Grid.Column="1" VerticalAlignment="Bottom"
                                    Content="Add from window" AutomationProperties.Name="Add text from an open window">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Use selected text" Click="ReadSelection_Click" />
                                <MenuFlyoutItem Text="Summarize selection" Tag="Summarize the selected text." Click="SelectionAction_Click" />
                                <MenuFlyoutItem Text="Explain selection" Tag="Explain the selected text in plain language." Click="SelectionAction_Click" />
                                <MenuFlyoutItem Text="Rewrite selection" Tag="Rewrite the selected text for clarity, preserving its meaning. Return only the rewrite." Click="SelectionAction_Click" />
                                <MenuFlyoutItem Text="Draft reply to selection" Tag="Draft a reply to the selected text. Return only the reply." Click="SelectionAction_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Read window" Click="ReadWindow_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="ModelButton" Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource WinferenceSubtleButtonStyle}"
                            ToolTipService.ToolTip="Choose the model that answers (Ctrl+M)" AutomationProperties.AutomationId="ChooseModel"
                            AutomationProperties.Name="Choose a model">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Shell.ModelName, Mode=OneWay}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Shell.HardwareBadgeLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="ModelFlyout" Placement="TopEdgeAlignedRight">
                                <StackPanel Spacing="8" Width="380">
                                    <ContentControl x:Name="ModelListHost" Height="340" IsTabStop="False"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                    <HyperlinkButton Content="Manage models" Click="ManageModels_Click" Padding="0,5" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="AskButton" Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                            Click="Ask_Click" AutomationProperties.AutomationId="AskButton">
                        <FontIcon x:Name="AskGlyph" Glyph="&#xE72A;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
