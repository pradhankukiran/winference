<Page
    x:Class="Winference.App.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Winference.App.Controls"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded"
    PreviewKeyDown="Page_PreviewKeyDown" KeyUp="Page_KeyUp"
    AutomationProperties.AutomationId="ChatPage">
    <Grid x:Name="PageLayout">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Style="{StaticResource WinferencePageHeaderStyle}">
            <StackPanel MaxWidth="{StaticResource WinferenceContentWidth}" Orientation="Horizontal" Spacing="12">
                <Button x:Name="ChooseModelButton" Style="{StaticResource WinferenceSubtleButtonStyle}" Padding="8,4" Margin="-8,0,0,0"
                        IsEnabled="{x:Bind ViewModel.Chat.CanChooseModel, Mode=OneWay}"
                        AutomationProperties.AutomationId="ChooseModelInChat" AutomationProperties.Name="Choose a model"
                        ToolTipService.ToolTip="Choose a model">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.ModelName, Mode=OneWay}" Style="{StaticResource WinferencePageTitleStyle}" MaxWidth="400"
                                   AutomationProperties.AutomationId="ChatHeading" AutomationProperties.HeadingLevel="Level1" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ModelFlyout" Placement="BottomEdgeAlignedLeft" Opening="ModelFlyout_Opening">
                            <StackPanel Spacing="8" Width="380">
                                <ContentControl x:Name="ModelListHost" Height="340" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <HyperlinkButton Content="Manage models" Click="ChooseModel_Click" Padding="0,5" AutomationProperties.AutomationId="BrowseModels" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ViewModel.Chat.CanLoadModel, Mode=OneWay}">
                                        <Button Content="Load now" Command="{x:Bind ViewModel.Chat.ConnectCommand, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.Chat.CanConnect, Mode=OneWay}" Click="ModelFlyoutAction_Click"
                                                Style="{StaticResource WinferenceSubtleButtonStyle}" AutomationProperties.AutomationId="LoadModel" />
                                        <Button Content="Unload" Command="{x:Bind ViewModel.Chat.DisconnectCommand, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.Chat.CanDisconnect, Mode=OneWay}" Click="ModelFlyoutAction_Click"
                                                Style="{StaticResource WinferenceSubtleButtonStyle}" AutomationProperties.AutomationId="UnloadModel"
                                                AutomationProperties.Name="Unload model" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" AutomationProperties.AutomationId="ChatStatus"
                            Visibility="{x:Bind ViewModel.Chat.CanLoadModel, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.HardwareBadgeLabel, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}"
                               AutomationProperties.AutomationId="ChatHardware" />
                    <TextBlock Text="·" Style="{StaticResource WinferenceCaptionStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.FriendlyStatus, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}"
                               AutomationProperties.AutomationId="ChatStatusText" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          ViewChanged="PageScroll_ViewChanged" SizeChanged="TranscriptViewport_SizeChanged"
                          AutomationProperties.AutomationId="ChatScroll">
                <Grid x:Name="TranscriptCanvas" Padding="{StaticResource WinferencePagePadding}">
                    <StackPanel x:Name="EmptyStatePanel" Spacing="12" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,12">
                        <TextBlock x:Name="EmptyTitle" Text="What would you like to work on?" Style="{StaticResource SubtitleTextBlockStyle}"
                                   TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="EmptyTitle" />
                        <TextBlock Text="Your conversation stays on this PC." Style="{StaticResource WinferenceCaptionStyle}"
                                   TextAlignment="Center" AutomationProperties.AutomationId="EmptyConversation" />
                        <Button x:Name="EmptyChooseModel" Content="Choose a model" Click="ChooseModel_Click" HorizontalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" AutomationProperties.AutomationId="EmptyChooseModel" />
                    </StackPanel>
                    <ListView x:Name="Transcript" SizeChanged="Transcript_SizeChanged" MaxWidth="{StaticResource WinferenceContentWidth}"
                              Padding="0" SelectionMode="None" IsItemClickEnabled="False" IsTabStop="False"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled"
                              ItemsSource="{x:Bind ViewModel.Chat.Messages, Mode=OneWay}"
                              AutomationProperties.AutomationId="ConversationTranscript">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                            <Setter Property="IsTabStop" Value="False" />
                        </Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate>
                            <StackPanel Spacing="4" Background="Transparent"
                                        PointerEntered="Message_PointerEntered" PointerExited="Message_PointerExited">
                                <TextBlock Text="{Binding SpeakerLabel}" Style="{StaticResource WinferenceCaptionStyle}" Visibility="{Binding LabelVisibility}" />
                                <Image Source="{Binding ImageSource}" Visibility="{Binding ImageVisibility}" MaxWidth="512" MaxHeight="512"
                                       HorizontalAlignment="Left" Stretch="Uniform" AutomationProperties.Name="Generated image" />
                                <Expander Header="Thinking" Visibility="{Binding ReasoningVisibility}" IsExpanded="False"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="{Binding ContentMaxWidth}"
                                          AutomationProperties.AutomationId="ReplyThinking" AutomationProperties.Name="Model's thinking">
                                    <TextBlock Text="{Binding Reasoning}" Style="{StaticResource WinferenceCaptionStyle}"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Expander>
                                <controls:MessageContent Text="{Binding DisplayText}" IsUser="{Binding IsUser}"
                                                         HorizontalAlignment="{Binding Alignment}" MaxWidth="{Binding ContentMaxWidth}" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource WinferenceCaptionStyle}" HorizontalAlignment="{Binding Alignment}"
                                           Visibility="{Binding StatusVisibility}" />
                                <TextBlock Text="{Binding Stats}" Style="{StaticResource WinferenceCaptionStyle}" Visibility="{Binding StatsVisibility}"
                                           AutomationProperties.AutomationId="ReplyStats" />
                                <StackPanel x:Name="MessageActions" Orientation="Horizontal" Spacing="2" Opacity="0" HorizontalAlignment="{Binding Alignment}">
                                    <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.1" /></StackPanel.OpacityTransition>
                                    <Button Click="CopyMessage_Click" Style="{StaticResource WinferenceSubtleButtonStyle}"
                                            GotFocus="MessageAction_GotFocus" LostFocus="MessageAction_LostFocus"
                                            IsEnabled="{Binding HasText}" Padding="6" MinHeight="28" ToolTipService.ToolTip="Copy message"
                                            AutomationProperties.AutomationId="CopyMessage" AutomationProperties.Name="Copy message">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                    </Button>
                                    <Button Click="EditMessage_Click" Style="{StaticResource WinferenceSubtleButtonStyle}"
                                            GotFocus="MessageAction_GotFocus" LostFocus="MessageAction_LostFocus"
                                            Visibility="{Binding EditVisibility}" Padding="6" MinHeight="28" ToolTipService.ToolTip="Edit and send again"
                                            AutomationProperties.AutomationId="EditMessage" AutomationProperties.Name="Edit and send again">
                                        <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                    </Button>
                                    <Button Click="Regenerate_Click" Style="{StaticResource WinferenceSubtleButtonStyle}"
                                            GotFocus="MessageAction_GotFocus" LostFocus="MessageAction_LostFocus"
                                            Visibility="{Binding RegenerateVisibility}" Padding="6" MinHeight="28" ToolTipService.ToolTip="Regenerate reply"
                                            AutomationProperties.AutomationId="RegenerateReply" AutomationProperties.Name="Regenerate reply">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    </Button>
                                    <Button Click="ReadAloud_Click" Style="{StaticResource WinferenceSubtleButtonStyle}"
                                            GotFocus="MessageAction_GotFocus" LostFocus="MessageAction_LostFocus"
                                            Visibility="{Binding SpeakVisibility}" IsEnabled="{Binding HasText}" Padding="6" MinHeight="28"
                                            ToolTipService.ToolTip="{Binding SpeakLabel}"
                                            AutomationProperties.AutomationId="ReadAloud" AutomationProperties.Name="{Binding SpeakLabel}">
                                        <FontIcon Glyph="{Binding SpeakGlyph}" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>
            <Button x:Name="ReturnToLatestButton" Content="Jump to latest" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,12,12,16"
                    Click="ReturnToLatest_Click" AutomationProperties.AutomationId="ReturnToLatest"
                    AutomationProperties.Name="Jump to latest message"
                    AutomationProperties.HelpText="Return to the newest reply and follow new messages." />
        </Grid>
        <StackPanel x:Name="ComposerSection" Grid.Row="2" Spacing="8" MaxWidth="{StaticResource WinferenceContentWidth}" Margin="24,0,24,16"
                    Background="Transparent" AllowDrop="True" DragOver="Composer_DragOver" Drop="Composer_Drop">
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6">
                    <InfoBar x:Name="ContextNotice" IsOpen="{x:Bind ViewModel.Chat.HasContextNotice, Mode=OneWay}"
                             IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.Chat.ContextNotice, Mode=OneWay}"
                             AutomationProperties.AutomationId="ChatContextNotice" AutomationProperties.LiveSetting="Polite" />
                    <InfoBar x:Name="ConnectionNotice" IsOpen="{x:Bind ViewModel.Chat.HasNotice, Mode=OneWay}"
                             IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.ConnectionDetail, Mode=OneWay}"
                             AutomationProperties.AutomationId="ChatNotice" AutomationProperties.LiveSetting="Polite">
                        <InfoBar.ActionButton>
                            <Button x:Name="NoticeChooseModel" Content="Choose a model" Click="ChooseModel_Click"
                                    AutomationProperties.AutomationId="NoticeChooseModel" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar IsOpen="{x:Bind ViewModel.Chat.HasPersistenceError, Mode=OneWay}" IsClosable="False" Severity="Error"
                             Message="{x:Bind ViewModel.Chat.PersistenceError, Mode=OneWay}" AutomationProperties.AutomationId="ChatSaveError" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.Chat.IsReadingDocument, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind ViewModel.Chat.IsReadingDocument, Mode=OneWay}" Width="14" Height="14" />
                <TextBlock Text="{x:Bind ViewModel.Chat.AttachingDetail, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}"
                           AutomationProperties.AutomationId="AttachingDetail" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Border Style="{StaticResource WinferenceCardStyle}" Padding="4" CornerRadius="8" HorizontalAlignment="Left"
                    Visibility="{x:Bind ViewModel.Chat.HasPendingImage, Mode=OneWay}" AutomationProperties.AutomationId="PendingImage">
                <Grid>
                    <Image Source="{x:Bind ViewModel.Chat.PendingImageSource, Mode=OneWay}" Height="72" MaxWidth="160" Stretch="Uniform"
                           AutomationProperties.Name="Picture to send" />
                    <Button Click="RemovePendingImage_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4" MinHeight="0" MinWidth="0"
                            Style="{StaticResource WinferenceSubtleButtonStyle}" ToolTipService.ToolTip="Remove picture"
                            AutomationProperties.Name="Remove picture" AutomationProperties.AutomationId="RemovePendingImage">
                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled"
                          Visibility="{x:Bind ViewModel.Chat.HasAttachments, Mode=OneWay}" AutomationProperties.AutomationId="ChatAttachments"
                          AutomationProperties.Name="Attached documents">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Chat.Attachments, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource WinferenceCardStyle}" Padding="10,2,2,2" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding FileName}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{Binding FileName}" />
                                <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource WinferenceCaptionStyle}" VerticalAlignment="Center" />
                                <Button Click="RemoveAttachment_Click" Style="{StaticResource WinferenceSubtleButtonStyle}" Padding="6" MinHeight="24"
                                        ToolTipService.ToolTip="{Binding RemoveLabel}" AutomationProperties.Name="{Binding RemoveLabel}"
                                        AutomationProperties.AutomationId="RemoveAttachment">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Style="{StaticResource WinferenceCardStyle}" Padding="6,6,6,6" CornerRadius="12" AutomationProperties.AutomationId="ComposerSurface">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                    <Button x:Name="AttachButton" VerticalAlignment="Bottom" Style="{StaticResource WinferenceSubtleButtonStyle}"
                            Width="36" Height="36" Padding="0" CornerRadius="8" Click="Attach_Click"
                            IsEnabled="{x:Bind ViewModel.Chat.CanAttach, Mode=OneWay}"
                            AutomationProperties.AutomationId="AttachDocument" AutomationProperties.Name="Attach a document"
                            AutomationProperties.HelpText="Add a PDF, picture, Word, text, Markdown, code or HTML file. You can also drop files here."
                            ToolTipService.ToolTip="Attach a document">
                        <FontIcon Glyph="&#xE723;" FontSize="14" />
                    </Button>
                    <Button x:Name="ImageButton" Style="{StaticResource WinferenceSubtleButtonStyle}"
                            Width="36" Height="36" Padding="0" CornerRadius="8" Click="Image_Click"
                            Visibility="{x:Bind ViewModel.Chat.HasImageAddon, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.Chat.CanStartImage, Mode=OneWay}"
                            AutomationProperties.AutomationId="CreateImage" AutomationProperties.Name="Create an image"
                            AutomationProperties.HelpText="Starts the message with /image. Describe the picture and send."
                            ToolTipService.ToolTip="Create an image">
                        <FontIcon Glyph="&#xEB9F;" FontSize="14" />
                    </Button>
                    </StackPanel>
                    <TextBox x:Name="Composer" Grid.Column="1" Text="{Binding DraftMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Message your local model…" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="32" MaxHeight="144" MaxLength="24000" Padding="0,6" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                             PreviewKeyDown="Composer_PreviewKeyDown" KeyUp="Composer_KeyUp"
                             TextCompositionStarted="Composer_TextCompositionStarted" TextCompositionEnded="Composer_TextCompositionEnded"
                             IsReadOnly="{x:Bind ViewModel.Chat.IsDraftReadOnly, Mode=OneWay}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.AutomationId="Composer" AutomationProperties.Name="Message draft"
                             AutomationProperties.HelpText="Enter sends when ready. Shift+Enter adds a new line. Text composition does not send.">
                        <!-- The surrounding card is the input's visible edge. -->
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                    <Button x:Name="MicButton" VerticalAlignment="Bottom" Style="{StaticResource WinferenceSubtleButtonStyle}"
                            Width="36" Height="36" Padding="0" CornerRadius="8" Click="Mic_Click"
                            Visibility="{x:Bind ViewModel.Chat.HasSpeechInput, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.Chat.CanDictate, Mode=OneWay}"
                            AutomationProperties.AutomationId="Dictate" AutomationProperties.Name="Speak a message"
                            ToolTipService.ToolTip="Speak a message (click again to stop)">
                        <FontIcon x:Name="MicGlyph" Glyph="&#xE720;" FontSize="14" />
                    </Button>
                    <Button x:Name="ComposerActionButton" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                            Width="36" Height="36" Padding="0" CornerRadius="8"
                            Click="ComposerAction_Click" IsEnabled="{x:Bind ViewModel.Chat.CanUseComposerAction, Mode=OneWay}"
                            AutomationProperties.AutomationId="ComposerAction"
                            AutomationProperties.Name="{x:Bind ViewModel.Chat.ComposerActionName, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Chat.ComposerActionName, Mode=OneWay}">
                        <FontIcon Glyph="{x:Bind ViewModel.Chat.ComposerActionGlyph, Mode=OneWay}" FontSize="14" />
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ResponseAnnouncement"
                           TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource WinferenceCaptionStyle}"
                           AutomationProperties.AutomationId="ResponseAnnouncement" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="RetryReplyButton" Grid.Column="1" Content="Retry reply" Style="{StaticResource WinferenceSubtleButtonStyle}"
                        Command="{x:Bind ViewModel.Chat.RetryCommand}" IsEnabled="{x:Bind ViewModel.Chat.CanRetryReply, Mode=OneWay}"
                        Click="RetryReply_Click" AutomationProperties.AutomationId="RetryReply" AutomationProperties.Name="Retry last reply"
                        AutomationProperties.HelpText="Try the last user message again without adding it twice." />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
