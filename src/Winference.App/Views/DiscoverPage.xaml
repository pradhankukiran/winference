<Page
    x:Class="Winference.App.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    AutomationProperties.AutomationId="DiscoverPage">
    <Page.Resources>
        <DataTemplate x:Key="FamilyCardTemplate">
            <Border Width="252" Height="132" Padding="14,12" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    AutomationProperties.Name="{Binding AutomationName}">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource WinferenceSectionTitleStyle}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{Binding Name}" />
                    <TextBlock Grid.Row="1" Text="{Binding Publisher}" Style="{StaticResource WinferenceCaptionStyle}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <StackPanel Grid.Row="2" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EnginesLabel}" Style="{StaticResource WinferenceCaptionStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding CapabilityLabel}" Style="{StaticResource WinferenceCaptionStyle}"
                                   Visibility="{Binding CapabilityVisibility}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <Grid Grid.Row="3">
                        <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource WinferenceCaptionStyle}" />
                        <TextBlock Text="{Binding FitLabel}" Style="{StaticResource WinferenceCaptionStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource WinferencePageHeaderStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Discover" Style="{StaticResource WinferencePageTitleStyle}"
                               AutomationProperties.AutomationId="DiscoverHeading" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{x:Bind ViewModel.HardwareSummary, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.UpdatedLabel, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}"
                           VerticalAlignment="Center" AutomationProperties.AutomationId="DiscoverUpdated" />
                <Grid Grid.Column="3">
                    <Button x:Name="RefreshButton" Click="Refresh_Click" Style="{StaticResource WinferenceSubtleButtonStyle}"
                            ToolTipService.ToolTip="Check for new models"
                            AutomationProperties.AutomationId="RefreshDiscover" AutomationProperties.Name="Check for new models">
                        <Grid>
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
                        </Grid>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,12,24,0" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}" IsClosable="True" Severity="Warning"
                     Message="{x:Bind ViewModel.Problem, Mode=OneWay}" AutomationProperties.AutomationId="DiscoverProblem" />
            <InfoBar IsOpen="{x:Bind ViewModel.Library.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Message="{x:Bind ViewModel.Library.Error, Mode=OneWay}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="Search" PlaceholderText="Search models" QueryIcon="Find" TextChanged="Search_TextChanged"
                                AutomationProperties.AutomationId="DiscoverSearch" AutomationProperties.Name="Search models" />
                <SelectorBar x:Name="RunsOnBar" Grid.Column="1" SelectionChanged="RunsOn_SelectionChanged"
                             AutomationProperties.Name="Show models that run on">
                    <SelectorBarItem x:Name="RunsOnAll" Text="All" IsSelected="True" />
                    <SelectorBarItem x:Name="RunsOnNpu" Text="NPU" />
                    <SelectorBarItem x:Name="RunsOnGpuNpu" Text="GPU + NPU" />
                    <SelectorBarItem x:Name="RunsOnGpu" Text="GPU" />
                </SelectorBar>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="NeedThinking" Content="Thinks" Click="Need_Click" AutomationProperties.Name="Only models that think before answering" />
                <ToggleButton x:Name="NeedPictures" Content="Sees pictures" Click="Need_Click" AutomationProperties.Name="Only models that see pictures" />
                <ToggleButton x:Name="NeedTools" Content="Uses tools" Click="Need_Click" AutomationProperties.Name="Only models that use tools" />
                <ToggleButton x:Name="NeedCoding" Content="Coding" Click="Need_Click" AutomationProperties.Name="Only coding models" />
                <CheckBox Content="Hide models that won't fit" Margin="12,0,0,0"
                          IsChecked="{x:Bind ViewModel.HideWontFit, Mode=TwoWay}" AutomationProperties.AutomationId="HideWontFit" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,24,24">
                <StackPanel Spacing="20">
                    <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Style="{StaticResource WinferenceSecondaryTextStyle}"
                               Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}" IsTabStop="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="20" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource WinferenceSectionTitleStyle}"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <GridView ItemsSource="{Binding Families}" SelectionMode="None" IsItemClickEnabled="True"
                                              ItemClick="Family_ItemClick" ItemTemplate="{StaticResource FamilyCardTemplate}"
                                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              AutomationProperties.Name="{Binding Title}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Width="380" Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" AutomationProperties.AutomationId="DiscoverDetail">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel Spacing="12" DataContext="{x:Bind ViewModel.Selected, Mode=OneWay}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource WinferenceCaptionStyle}" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="CloseDetail_Click"
                                    Style="{StaticResource WinferenceSubtleButtonStyle}" ToolTipService.ToolTip="Close"
                                    AutomationProperties.Name="Close details">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource WinferenceSecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CapabilityLabel}" Style="{StaticResource WinferenceCaptionStyle}" Visibility="{Binding CapabilityVisibility}" />
                        <TextBlock Text="Versions" Style="{StaticResource WinferenceSectionTitleStyle}" Margin="0,8,0,0" />
                        <ItemsControl ItemsSource="{Binding Variants}" IsTabStop="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource WinferenceCardStyle}">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Badge}" Style="{StaticResource WinferenceSectionTitleStyle}" />
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource WinferenceCaptionStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding Entry.ActionLabel}" Click="Action_Click" MinWidth="72"
                                                        VerticalAlignment="Top" Visibility="{Binding Entry.ActionVisibility}"
                                                        IsEnabled="{Binding Entry.CanAct}" AutomationProperties.Name="{Binding Entry.ActionAutomationName}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource WinferenceCaptionStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Entry.StatusLine}" Style="{StaticResource WinferenceCaptionStyle}" TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar Visibility="{Binding Entry.ProgressVisibility}" IsIndeterminate="{Binding Entry.IsProgressIndeterminate}"
                                                         Value="{Binding Entry.ProgressValue}" Maximum="100" AutomationProperties.Name="Download progress" />
                                            <Expander Header="Technical details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <TextBlock Text="{Binding TechnicalDetails}" Style="{StaticResource WinferenceCaptionStyle}"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
