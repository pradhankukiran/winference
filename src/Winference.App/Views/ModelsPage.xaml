<Page
    x:Class="Winference.App.Views.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded"
    AutomationProperties.AutomationId="ModelsPage">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource WinferencePageHeaderStyle}">
            <Grid MaxWidth="{StaticResource WinferenceContentWidth}" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Models" Style="{StaticResource WinferencePageTitleStyle}"
                           AutomationProperties.AutomationId="ModelsHeading" AutomationProperties.HeadingLevel="Level1" />
                <TextBox x:Name="ModelSearch" Grid.Column="1" PlaceholderText="Search models" VerticalAlignment="Center"
                         TextChanged="ModelSearch_TextChanged"
                         AutomationProperties.AutomationId="ModelSearch" AutomationProperties.Name="Search models" />
                <Button Grid.Column="2" Click="Refresh_Click" Style="{StaticResource WinferenceSubtleButtonStyle}" ToolTipService.ToolTip="Refresh models"
                        AutomationProperties.AutomationId="RefreshModels" AutomationProperties.Name="Refresh models">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button Grid.Column="3" Content="Add a model" Click="Add_Click" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="AddModel"
                        AutomationProperties.HelpText="Choose a .gguf file, or the genai_config.json file in a Ryzen AI model folder." />
            </Grid>
        </Border>
        <Grid Grid.Row="1" MaxWidth="{StaticResource WinferenceContentWidth}" Margin="24,12,24,0" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <InfoBar IsOpen="{x:Bind Library.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Message="{x:Bind Library.Error, Mode=OneWay}" AutomationProperties.AutomationId="ModelLibraryError" />
            <ContentControl x:Name="ListHost" Grid.Row="1" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Page>
