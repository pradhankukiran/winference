<Page
    x:Class="Winference.App.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    AutomationProperties.AutomationId="WelcomePage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Width="560" HorizontalAlignment="Center" Spacing="24" Padding="16,32" VerticalAlignment="Center">
            <StackPanel Spacing="8">
                <TextBlock Text="Welcome to Winference" Style="{StaticResource WinferenceHeroTitleStyle}"
                           AutomationProperties.AutomationId="WelcomeHeading" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="Private AI that runs entirely on this PC." Style="{StaticResource WinferenceSecondaryTextStyle}" />
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind Library.IsChecking, Mode=OneWay}">
                <TextBlock Text="Checking this PC…" Style="{StaticResource WinferenceSecondaryTextStyle}"
                           AutomationProperties.AutomationId="WelcomeChecking" AutomationProperties.LiveSetting="Polite" />
                <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Checking this PC" />
            </StackPanel>

            <Border Style="{StaticResource WinferenceCardStyle}" Visibility="{x:Bind Library.HasRecommendation, Mode=OneWay}"
                    AutomationProperties.AutomationId="WelcomeRecommendation">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Recommended for this PC" Style="{StaticResource WinferenceCaptionStyle}" />
                        <TextBlock Text="{x:Bind Library.RecommendedName, Mode=OneWay}" Style="{StaticResource WinferenceSectionTitleStyle}"
                                   AutomationProperties.AutomationId="RecommendedModel" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="{x:Bind Library.RecommendedDetail, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}" />
                    </StackPanel>
                    <Button Content="{x:Bind Library.RecommendedAction, Mode=OneWay}" Click="Recommended_Click"
                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                            Visibility="{x:Bind ShowGetButton, Mode=OneWay}"
                            AutomationProperties.AutomationId="GetRecommended" />
                    <StackPanel Spacing="8" Visibility="{x:Bind Library.IsDownloading, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Library.DownloadStatus, Mode=OneWay}" Style="{StaticResource WinferenceCaptionStyle}"
                                   AutomationProperties.AutomationId="WelcomeDownloadStatus" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar IsIndeterminate="{x:Bind Library.IsDownloadIndeterminate, Mode=OneWay}" Value="{x:Bind Library.DownloadValue, Mode=OneWay}"
                                     Maximum="100" AutomationProperties.Name="Download progress" />
                        <Button Content="Cancel" Click="Cancel_Click" AutomationProperties.AutomationId="CancelDownload" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WinferenceCardStyle}" Visibility="{x:Bind Library.IsUnsupported, Mode=OneWay}"
                    AutomationProperties.AutomationId="WelcomeUnsupported">
                <StackPanel Spacing="12">
                    <TextBlock Text="This PC isn't ready yet" Style="{StaticResource WinferenceSectionTitleStyle}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{x:Bind Library.HardwareProblem, Mode=OneWay}" Style="{StaticResource WinferenceSecondaryTextStyle}"
                               AutomationProperties.AutomationId="WelcomeProblem" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton Content="Check NPU requirements" NavigateUri="https://lemonade-server.ai/driver_install.html"
                                         AutomationProperties.AutomationId="DriverHelp" />
                        <Button Content="Check again" Click="CheckAgain_Click" AutomationProperties.AutomationId="CheckAgain" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <HyperlinkButton Content="Use a file I already have" Click="UseFile_Click" AutomationProperties.AutomationId="UseExistingFile"
                                 AutomationProperties.HelpText="Choose a .gguf file, or the genai_config.json file in a Ryzen AI model folder." />
                <HyperlinkButton Content="See all models" Click="AllModels_Click" AutomationProperties.AutomationId="SeeAllModels" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
